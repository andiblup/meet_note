/* @import "tailwindcss/base";
@import "tailwindcss/components";
@import "tailwindcss/utilities"; */
@import "tailwindcss";
@import "basecoat-css";
@import "./themes.css";
@import "./theme-supabase.css";
@import "./themes.css";
/* @import "./theme-purple.css"; */
@import "./quill-theme.css";
@import "./theme-utils.css";

.ql-toolbar.ql-snow {
    background: var(--card);
    border-color: var(--border);
    color: var(--foreground);
}
.ql-toolbar.ql-snow .ql-picker {
    color: var(--foreground);
}
.ql-toolbar.ql-snow .ql-stroke {
    stroke: var(--foreground);
}
.ql-toolbar.ql-snow .ql-fill {
    fill: var(--foreground);
}
.ql-toolbar.ql-snow .ql-picker-options {
    background: var(--card);
    border-color: var(--border);
    color: var(--foreground);
}
.ql-container.ql-snow {
    background: var(--card);
    border-color: var(--border);
}
.ql-editor {
    color: var(--foreground);
}
.ql-editor a {
    color: var(--primary);
}
.ql-snow .ql-tooltip {
    background: var(--card);
    color: var(--foreground);
    border-color: var(--border);
}
.ql-snow .ql-tooltip input[type="text"] {
    background: var(--card);
    color: var(--foreground);
    border: 1px solid var(--border);
}

.ql-snow .ql-formats button:hover,
.ql-snow .ql-picker-label:hover,
.ql-snow .ql-picker-item:hover,
.ql-snow .ql-formats button:active,
.ql-snow .ql-picker-label:active,
.ql-snow .ql-picker-item:active,
.ql-snow .ql-formats button:focus,
.ql-snow .ql-picker-label:focus,
.ql-snow .ql-picker-item:focus,
.ql-snow .ql-formats button:focus-within,
.ql-snow .ql-picker-label:focus-within,
.ql-snow .ql-picker-item:focus-within,
.ql-snow .ql-formats button:target,
.ql-snow .ql-picker-label:target,
.ql-snow .ql-picker-item:target
 {
    background: var(--background)!important;
    /* background: var(--grey-hover)!important; */
    /* background: red!important; */
    /* color: var(--primary-strong)!important; */
    color: var(--primary-strong)!important;
    border: none;
}
.ql-snow .ql-formats button:focus,
.ql-snow .ql-picker-label:focus,
.ql-snow .ql-picker-item:focus {
    outline: 2px solid var(--primary)!important;
    /* outline-offset: 2px; */
    border: none;
}

.ql-picker-options {
    background: var(--card);
    border-color: var(--border)!important;
    color: var(--foreground);
}

.ql-snow.ql-toolbar button:hover, .ql-snow .ql-toolbar button:hover, .ql-snow.ql-toolbar button:focus, .ql-snow .ql-toolbar button:focus, .ql-snow.ql-toolbar button.ql-active, .ql-snow .ql-toolbar button.ql-active, .ql-snow.ql-toolbar .ql-picker-label:hover, .ql-snow .ql-toolbar .ql-picker-label:hover, .ql-snow.ql-toolbar .ql-picker-label.ql-active, .ql-snow .ql-toolbar .ql-picker-label.ql-active, .ql-snow.ql-toolbar .ql-picker-item:hover, .ql-snow .ql-toolbar .ql-picker-item:hover, .ql-snow.ql-toolbar .ql-picker-item.ql-selected, .ql-snow .ql-toolbar .ql-picker-item.ql-selected {
    background: var(--background)!important;
    /* background: var(--grey-hover)!important; */
    color: var(--primary-hover-second)!important;
    /* color: #894bef!important; */
}

.ql-editor.ql-blank::before{
    color: var(--foreground)!important;
}

::selection {
background-color: var(--color-primary);
    color: var(--color-primary-foreground);
  /* background: var(--popover-foreground)!important;
  color: var(--background)!important; */
}


/* .btn:hover, .btn a:hover {
    background-color: var(--primary)!important;
} */

a {
    color: var(--primary);
    /* text-decoration: underline; */
    font-weight: bold;

}

a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
}
a:active {
    color: var(--primary-strong);
    font-weight: bold;

}
a:focus {
    color: var(--primary-disabled);
    text-decoration: none;
    font-weight: bold;

}



.btn a {
    color: var(--button-foreground);
    text-decoration: none;
    font-weight: bold;
}

