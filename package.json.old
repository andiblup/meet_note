{
  "name": "meet_note",
  "version": "0.2.0",
  "private": true,
  "description": "LAN-Notiz-App mit Electron + Express + Socket.IO + Quill + BasecoatUI",
  "main": "electron/main.js",
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:css": "tailwindcss -i ./public/styles/input.css -o ./public/styles/output.css --watch",
    "dev:web": "npm-run-all --parallel dev:server dev:css",
    "build:css": "tailwindcss -i ./public/styles/input.css -o ./public/styles/output.css",
    "prepare:vendor": "npx cpx \"node_modules/quill/dist/**\" public/vendor/quill && npx cpx node_modules/iconify-icon/dist/iconify-icon.min.js public/vendor/iconify",
    "build": "npm run prepare:vendor && npm run build:css",
    "electron": "npm run build && electron .",
    "start": "node server/server.js"
  },
  "dependencies": {
    "basecoat-css": "^0.3.2",
    "chalk": "4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "iconify-icon": "^3.0.1",
    "log-symbols": "4.1.0",
    "ora": "5.4.1",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0",
    "signale": "^1.4.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16",
    "autoprefixer": "^10.4.21",
    "electron": "^28.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.2",
    "tailwindcss": "^4.1.16"
  }
}
