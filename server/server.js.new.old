//! ////////



/* ------------------------------------------------------------------
 * MeetNote – Express + Socket.IO Server
 * Features:
 *  - Rooms & Notes (JSON pro Room) mit Owner-Tracking
 *  - Realtime Deltas (Quill) – compose + broadcast
 *  - Quill Image Upload (Dateien, URL im Delta)
 *  - Rooms CRUD + Room Export (ZIP)
 *  - LAN Peer Scan (manuell) + Broadcast
 *  - Standalone nutzbar (ohne Electron)
 * -----------------------------------------------------------------*/

const path = require('path');
const fs = require('fs');
const os = require('os');
const http = require('http');
const net = require('net');

const express = require('express');
const cors = require('cors');
const { Server } = require('socket.io');
const Delta = require('quill-delta');

const multer = require('multer');      // npm i multer
const archiver = require('archiver');  // npm i archiver

/* ---------- Konfiguration --------------------------------------- */
const PORT = Number(process.env.PORT || 55555);

const ROOT_DIR     = path.join(__dirname, '..');
const PUBLIC_DIR   = path.join(ROOT_DIR, 'public');
const DATA_DIR     = path.join(ROOT_DIR, 'data');
const ROOMS_DIR    = path.join(DATA_DIR, 'rooms');
const UPLOADS_DIR  = path.join(DATA_DIR, 'uploads');

fs.mkdirSync(DATA_DIR, { recursive: true });
fs.mkdirSync(ROOMS_DIR, { recursive: true });
fs.mkdirSync(UPLOADS_DIR, { recursive: true });

/* Default-Room beim Start wipen (wie gewünscht) */
(function wipeDefaultRoomOnStart() {
  const df = path.join(ROOMS_DIR, 'default.json');
  try { if (fs.existsSync(df)) fs.unlinkSync(df); } catch {}
  const du = path.join(UPLOADS_DIR, 'default');
  try { if (fs.existsSync(du)) fs.rmSync(du, { recursive: true, force: true }); } catch {}
})();

/* ---------- Express/HTTP/Socket.IO --------------------------------*/
const app = express();
const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });

app.use(cors());
app.use(express.json({ limit: '4mb' }));  // JSON für kleine Admin-Calls
app.use(express.static(PUBLIC_DIR));

/* Healthcheck */
app.get('/health', (_req, res) => res.json({ ok: true }));

/* ---------- Helpers: Rooms & Storage ------------------------------ */
function safeId(s) {
  const v = String(s || '').trim();
  if (!/^[a-z0-9._-]{1,64}$/i.test(v)) throw new Error('invalid id');
  return v;
}
function roomFile(roomId) {
  return path.join(ROOMS_DIR, `${safeId(roomId)}.json`);
}
function loadRoom(roomId) {
  const f = roomFile(roomId);
  if (!fs.existsSync(f)) return {
    title: roomId,
    notes: {},                 // noteId -> full Delta (ops array)
    meta: { owners: {} },      // owners[noteId] = userId
    updatedAt: Date.now()
  };
  try {
    const data = JSON.parse(fs.readFileSync(f, 'utf8'));
    if (!data.notes) data.notes = {};
    if (!data.meta)  data.meta  = { owners: {} };
    if (!data.meta.owners) data.meta.owners = {};
    Object.keys(data.notes).forEach(k => {
      const d = data.notes[k];
      if (!d || !Array.isArray(d.ops)) data.notes[k] = { ops: [] };
    });
    return data;
  } catch {
    return { title: roomId, notes: {}, meta: { owners: {} }, updatedAt: Date.now() };
  }
}
function saveRoom(roomId, state) {
  fs.writeFileSync(roomFile(roomId), JSON.stringify(state));
}
function listRooms() {
  const files = fs.readdirSync(ROOMS_DIR).filter(f => f.endsWith('.json'));
  return files.map(f => {
    const id = path.basename(f, '.json');
    const st = loadRoom(id);
    return {
      id,
      title: st.title || id,
      updatedAt: st.updatedAt || 0,
      noteCount: Object.keys(st.notes || {}).length
    };
  }).sort((a, b) => (b.updatedAt - a.updatedAt) || a.id.localeCompare(b.id));
}
function createRoom(id, title) {
  id = safeId(id);
  const f = roomFile(id);
  if (fs.existsSync(f)) throw new Error('exists');
  const st = { title: title || id, notes: {}, meta: { owners: {} }, updatedAt: Date.now() };
  saveRoom(id, st);
  return st;
}
function renameRoom(oldId, newId) {
  oldId = safeId(oldId); newId = safeId(newId);
  const src = roomFile(oldId), dst = roomFile(newId);
  if (!fs.existsSync(src)) throw new Error('notfound');
  if (fs.existsSync(dst)) throw new Error('exists');
  fs.renameSync(src, dst);
  // Uploads-Verzeichnis mit verschieben
  const srcU = path.join(UPLOADS_DIR, oldId);
  const dstU = path.join(UPLOADS_DIR, newId);
  if (fs.existsSync(srcU)) {
    fs.mkdirSync(path.dirname(dstU), { recursive: true });
    fs.renameSync(srcU, dstU);
  }
}

/* ---------- Quill Image Upload (Dateien) -------------------------- */
app.use('/uploads', express.static(UPLOADS_DIR));

const storage = multer.diskStorage({
  destination: (req, _file, cb) => {
    let roomId = 'default';
    try { roomId = safeId(req.query.room || 'default'); } catch {}
    const dir = path.join(UPLOADS_DIR, roomId);
    fs.mkdirSync(dir, { recursive: true });
    cb(null, dir);
  },
  filename: (_req, file, cb) => {
    const ext = path.extname(file.originalname || '').toLowerCase() || '.bin';
    const name = `${Date.now()}-${Math.random().toString(36).slice(2,8)}${ext}`;
    cb(null, name);
  }
});
const upload = multer({ storage });

app.post('/api/upload/quill-image', upload.single('image'), (req, res) => {
  try {
    const roomId = safeId(req.query.room || 'default');
    if (!req.file) return res.status(400).json({ ok: false, error: 'no file' });
    const url = `/uploads/${roomId}/${req.file.filename}`;
    res.json({ ok: true, url });
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

/* ---------- Rooms CRUD & Snapshot -------------------------------- */
app.get('/api/rooms', (_req, res) => res.json({ rooms: listRooms() }));

app.post('/api/rooms', (req, res) => {
  try {
    const { id, title } = req.body || {};
    createRoom(id, title);
    io.emit('rooms/changed', { rooms: listRooms() });
    res.json({ ok: true });
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

app.put('/api/rooms/:id', (req, res) => {
  try {
    const id = safeId(req.params.id);
    const { newId, title } = req.body || {};
    const finalId = newId && newId !== id ? safeId(newId) : id;
    if (finalId !== id) renameRoom(id, finalId);
    if (title) {
      const st = loadRoom(finalId);
      st.title = String(title);
      st.updatedAt = Date.now();
      saveRoom(finalId, st);
    }
    io.emit('rooms/changed', { rooms: listRooms() });
    res.json({ ok: true });
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

app.delete('/api/rooms/:id', (req, res) => {
  try {
    const id = safeId(req.params.id);
    const f = roomFile(id);
    if (fs.existsSync(f)) fs.unlinkSync(f);
    const up = path.join(UPLOADS_DIR, id);
    if (fs.existsSync(up)) fs.rmSync(up, { recursive: true, force: true });
    io.emit('rooms/changed', { rooms: listRooms() });
    res.json({ ok: true });
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

app.get('/api/rooms/:id', (req, res) => {
  try {
    const id = safeId(req.params.id);
    const st = loadRoom(id);
    res.json(st);
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

/* ---------- Room Export (ZIP) ------------------------------------ */
app.get('/api/rooms/:id/export.zip', async (req, res) => {
  try {
    const id = safeId(req.params.id);
    const st = loadRoom(id);

    res.setHeader('Content-Type', 'application/zip');
    res.setHeader('Content-Disposition', `attachment; filename="room-${id}.zip"`);

    const archive = archiver('zip', { zlib: { level: 9 } });
    archive.on('error', err => { try { res.status(500).end(); } catch {} });
    archive.pipe(res);

    // room.json
    archive.append(Buffer.from(JSON.stringify(st, null, 2)), { name: 'room.json' });

    // uploads/<roomId>/*
    const upDir = path.join(UPLOADS_DIR, id);
    if (fs.existsSync(upDir)) {
      archive.directory(upDir, `uploads/${id}`);
    }
    await archive.finalize();
  } catch (e) {
    res.status(400).json({ ok: false, error: String(e.message || e) });
  }
});

/* ---------- LAN Peers Scan (manuell) ------------------------------ */
const SCAN_PORT         = PORT;     // derselbe Port, damit andere Hosts gefunden werden
const SCAN_TIMEOUT      = 300;      // ms
const SCAN_CONCURRENCY  = 256;
const SCAN_INTERVAL_MS  = 30_000;   // Cooldown
const SCAN_CIDRS        = process.env.SCAN_CIDRS?.split(',').map(s => s.trim());

const peersCache = {
  peers: [],         // [{ ip, port, healthy }]
  updatedAt: 0,
  nextAllowedAt: 0,
};

function ipToInt(ip) { return ip.split('.').reduce((a,o)=>(a<<8)+(+o),0)>>>0 }
function intToIp(i) { return [(i>>>24)&255,(i>>>16)&255,(i>>>8)&255,i&255].join('.') }
function cidrToRange(cidr) {
  const [ip,p] = cidr.split('/');
  const prefix = Number(p);
  const base = ipToInt(ip);
  const mask = prefix === 0 ? 0 : (~((1 << (32 - prefix)) - 1) >>> 0);
  const net  = base & mask;
  const first = net + 1;
  const last  = (net | (~mask >>> 0)) - 1;
  return { first, last };
}
function localCIDRsFallback24() {
  const out = [];
  const nets = os.networkInterfaces();
  for (const infos of Object.values(nets)) {
    for (const i of infos || []) {
      if (i.family !== 'IPv4' || i.internal) continue;
      if (!/^10\.|^192\.168\.|^172\.(1[6-9]|2\d|3[0-1])\./.test(i.address)) continue;
      const [a,b,c] = i.address.split('.');
      out.push(`${a}.${b}.${c}.0/24`);
    }
  }
  return [...new Set(out)];
}
function buildTargets() {
  const cidrs = SCAN_CIDRS && SCAN_CIDRS.length ? SCAN_CIDRS : localCIDRsFallback24();
  const ips = [];
  for (const c of cidrs) {
    const { first, last } = cidrToRange(c);
    for (let n = first; n <= last; n++) ips.push(intToIp(n));
  }
  return ips;
}
function checkPort(ip, port, timeoutMs) {
  return new Promise(res => {
    const s = new net.Socket();
    let done = false;
    const finish = ok => { if (!done) { done = true; s.destroy(); res(ok); } };
    s.setTimeout(timeoutMs);
    s.once('connect', () => finish(true));
    s.once('timeout', () => finish(false));
    s.once('error',  () => finish(false));
    s.connect(port, ip);
  });
}
async function scanPeers() {
  const targets = buildTargets();
  const found = [];
  let i = 0;
  async function worker() {
    while (i < targets.length) {
      const idx = i++; const ip = targets[idx];
      const ok = await checkPort(ip, SCAN_PORT, SCAN_TIMEOUT);
      if (ok) {
        try {
          const r = await fetch(`http://${ip}:${SCAN_PORT}/health`, { signal: AbortSignal.timeout(500) }).catch(() => null);
          found.push({ ip, port: SCAN_PORT, healthy: !!(r && r.ok) });
        } catch {
          found.push({ ip, port: SCAN_PORT, healthy: false });
        }
      }
    }
  }
  const workers = Array.from({ length: Math.min(SCAN_CONCURRENCY, 512) }, worker);
  await Promise.all(workers);
  found.sort((a,b)=> (b.healthy - a.healthy) || (a.ip > b.ip ? 1 : -1));
  return found;
}
function canScanNow() { return Date.now() >= peersCache.nextAllowedAt; }

app.get('/api/peers', (_req, res) => {
  res.json({
    peers: peersCache.peers,
    updatedAt: peersCache.updatedAt,
    nextAllowedAt: peersCache.nextAllowedAt,
    now: Date.now(),
  });
});
app.post('/api/peers/refresh', async (_req, res) => {
  if (!canScanNow()) {
    return res.status(429).json({
      error: 'cooldown',
      retryIn: Math.max(0, peersCache.nextAllowedAt - Date.now()),
      nextAllowedAt: peersCache.nextAllowedAt,
      updatedAt: peersCache.updatedAt,
      peers: peersCache.peers,
    });
  }
  const peers = await scanPeers();
  peersCache.peers = peers;
  peersCache.updatedAt = Date.now();
  peersCache.nextAllowedAt = Date.now() + SCAN_INTERVAL_MS;
  io.emit('peers-updated', { peers, updatedAt: peersCache.updatedAt });
  res.json({ ok:true, peers, updatedAt: peersCache.updatedAt, nextAllowedAt: peersCache.nextAllowedAt });
});

/* ---------- Socket.IO: Realtime Notes ----------------------------- */
io.on('connection', (socket) => {
  let roomId = null;

  // einfache User-Identität (IP oder Socket-ID)
  const userId = socket.handshake.address || socket.id;
  socket.emit('whoami', { userId });

  // Beim Connect aktuellen Peer-Stand schicken (UI nutzt das ggf.)
  socket.emit('peers-updated', { peers: peersCache.peers, updatedAt: peersCache.updatedAt });

  socket.on('join-room', (rid) => {
    const target = String(rid || 'default');
    if (roomId) socket.leave(roomId);
    roomId = target;
    socket.join(roomId);

    const state = loadRoom(roomId);
    socket.emit('init', {
      title: state.title || roomId,
      notes: state.notes || {},
      meta:  state.meta  || { owners: {} },
      updatedAt: state.updatedAt || Date.now()
    });
  });

  // Neue Note
  socket.on('create-note', ({ noteId, title }) => {
    if (!roomId || !noteId) return;
    const st = loadRoom(roomId);
    if (!st.notes[noteId]) {
      st.notes[noteId] = { ops: [] };
      st.meta = st.meta || { owners: {} };
      st.meta.owners[noteId] = userId;
      st.updatedAt = Date.now();
      saveRoom(roomId, st);
      io.to(roomId).emit('note/created', { noteId, title: title || `Notiz ${noteId}`, owner: userId });
    }
  });

  // Note löschen
  socket.on('delete-note', ({ noteId }) => {
    if (!roomId || !noteId) return;
    const st = loadRoom(roomId);
    if (st.notes[noteId]) {
      delete st.notes[noteId];
      if (st.meta?.owners) delete st.meta.owners[noteId];
      st.updatedAt = Date.now();
      saveRoom(roomId, st);
      io.to(roomId).emit('note/deleted', { noteId });
    }
  });

  // Delta-Ankunft (compose + broadcast)
  socket.on('delta', (payload) => {
    if (!roomId || !payload?.noteId || !payload?.delta) return;
    const { noteId, delta } = payload;
    const st = loadRoom(roomId);
    const current  = new Delta(st.notes[noteId] || { ops: [] });
    const incoming = new Delta(delta);
    const composed = current.compose(incoming);

    st.notes[noteId] = composed;
    st.meta = st.meta || { owners: {} };
    if (!st.meta.owners[noteId]) st.meta.owners[noteId] = userId;
    st.updatedAt = Date.now();
    saveRoom(roomId, st);

    // an andere im Room
    socket.to(roomId).emit('delta', { noteId, delta, author: userId });
  });

  socket.on('disconnect', () => {});
});

/* ---------- Start ------------------------------------------------- */
server.listen(PORT, () => {
  console.log(`[server] listening on :${PORT}`);
});




